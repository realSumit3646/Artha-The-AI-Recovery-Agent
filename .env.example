# Groq is the default provider. Its free tier is the only one that can run
# this project's ablation: 1,000 requests and 200,000 tokens per day, against
# Gemini's 20 requests per day.
#
# Two keys on DIFFERENT Groq accounts double the daily allowance and the
# client rotates between them on a quota error. Two keys on the SAME account
# share one pool and buy nothing.
GROQ_API_KEY=
GROQ_API_KEY_2=

# Optional. The provider this project started on; still supported, still
# quota-blocked for a full run.
GEMINI_API_KEY=

# Only needed to run the LLM arm live. Stored results reproduce from the
# committed response cache in llm_cache/ without any key at all.
